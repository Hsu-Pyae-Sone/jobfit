# Copy this file to .env.local (local development) or enter these values as Environment
# Variables in Vercel. Never commit real values. Only variables starting with NEXT_PUBLIC_
# reach the browser, and those are safe to expose.

# ---- Supabase (accounts, database, private file storage) ----
# Dashboard → Project Settings → API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy "anon" key. Safe for browsers; row-level security protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy "service_role" key. SERVER ONLY. Used for invitations,
# account deletion and the shared job-listing cache.
SUPABASE_SECRET_KEY=
# Database connection string, only for `npm run db:migrate` (Dashboard → Connect → Session pooler).
# SUPABASE_DB_URL=

# Public address of the app, used in invitation and password-reset links.
# Local: http://127.0.0.1:3000 (npm run dev listens there)   Vercel: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Comma-separated emails that can open the Admin page and invite people.
ADMIN_EMAILS=

# Private-beta limits.
# BETA_MAX_USERS=10
# AI requests per user per day (stored results for identical requests don't count).
# AI_DAILY_LIMIT=40
# Public registration (off for the private beta). Also enable sign-ups in Supabase Auth.
# ALLOW_SIGNUPS=1

# ---- AI ----
# AI features (analysis, rewriting, cover letters, AI review, AI OCR, match assessments).
# Upload, on-device OCR, automatic checks, search, tracking and export work without it.
ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-opus-5-5)
# CAREERFIT_MODEL=claude-opus-5-5

# ---- Job search sources ----
# Arbeitnow, Remotive and Jobicy need no key and are always on.
# Adzuna (free developer key: https://developer.adzuna.com) — many countries, not Finland.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# Optional: countries to query on Adzuna (ISO codes). Unsupported ones are reported per search.
# ADZUNA_COUNTRIES=GB,US,AT,AU,BE,BR,CA,CH,DE,ES,FR,IN,IT,MX,NL,NZ,PL,SG,ZA
# Jooble (free key per country: https://jooble.org/api/about) — needed for on-site jobs in Finland.
# Free keys have a lifetime limit of 500 requests (shared by all users); results are cached for 24 hours.
# JOOBLE_KEYS=FI:your-finland-key,DE:your-germany-key

# ---- Local single-user mode (no Supabase) ----
# Used automatically by `npm run dev` when the Supabase variables are empty. Data goes to ./data.
# To run a production build locally without Supabase (tests), set:
# CAREERFIT_LOCAL_MODE=1
# CAREERFIT_DATA_DIR=./data
